# Copy to .env.local and fill in your own values. Never commit real keys.
#
# VITE_* variables are bundled into the browser build, so they must be
# *public* identifiers only (anon key, public IDs). Server secrets
# (service-role key, Razorpay secret, webhooks) belong in Supabase function
# secrets / GitHub Actions secrets, never here.

VITE_APP_ENV=development

# Supabase (required: the app throws at startup without these two)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay publishable key id (use a rzp_test_ key outside production)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Google Maps. Restrict the key by HTTP referrer in Google Cloud Console.
# A Map ID enables vector rendering + AdvancedMarkerElement.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAP_ID=your-google-map-id

# Telemetry. All five are REQUIRED when the app runs as a production build
# (see src/lib/monitoring/config.ts); they are optional in development.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
VITE_CLARITY_PROJECT_ID=your-clarity-project-id
VITE_META_PIXEL_ID=your-meta-pixel-id
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Comma-separated origins allowed to send telemetry (must also be set as
# ALLOWED_TELEMETRY_ORIGINS on the telemetry-ingest Supabase function).
VITE_ALLOWED_TELEMETRY_ORIGINS=http://localhost:5173
